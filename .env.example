# Copy this file to .env.local for local development (vercel dev),
# or add these as Environment Variables in the Vercel project dashboard.
# Never commit the real values.

TELEGRAM_BOT_TOKEN=
# One chat_id, or several separated by commas (e.g. 111111111,222222222)
# to notify multiple people.
TELEGRAM_CHAT_ID=

# Any password you make up — gates /api/rsvp-stats (?key=...).
ADMIN_KEY=

# KV_REST_API_URL / KV_REST_API_TOKEN etc. are added automatically by the
# Vercel KV / Upstash Redis integration — no need to set those by hand.
